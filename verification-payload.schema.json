{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GhanaCardVerificationPayload",
  "description": "Standardized payload schema for Ghana Card NFC, Biometric, and Chip Integrity Verification",
  "type": "object",
  "required": [
    "sessionId",
    "timestamp",
    "mrzData",
    "nfcChipData",
    "biometrics",
    "verificationStatus"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique transaction ID generated by the client app."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when NFC scan completed."
    },
    "mrzData": {
      "type": "object",
      "description": "Extracted Machine Readable Zone fields used to calculate BAC keys.",
      "required": ["documentNumber", "dateOfBirth", "dateOfExpiry", "mrzRaw"],
      "properties": {
        "documentNumber": {
          "type": "string",
          "pattern": "^[A-Z0-9]{9}$"
        },
        "dateOfBirth": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "YYMMDD format extracted from MRZ"
        },
        "dateOfExpiry": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "YYMMDD format extracted from MRZ"
        },
        "mrzRaw": {
          "type": "string",
          "description": "Raw string scanned from camera OCR"
        }
      }
    },
    "nfcChipData": {
      "type": "object",
      "description": "Cryptographic payload extracted directly from the NFC chip via ICAO 9303 standards.",
      "required": [
        "dg1PersonalDetails",
        "dg2FacePhotoBase64",
        "passiveAuthentication",
        "activeAuthentication"
      ],
      "properties": {
        "dg1PersonalDetails": {
          "type": "object",
          "required": ["nationalIdNumber", "surname", "givenNames", "gender"],
          "properties": {
            "nationalIdNumber": {
              "type": "string",
              "pattern": "^GHA-[0-9]{9}-[0-9]$"
            },
            "surname": { "type": "string" },
            "givenNames": { "type": "string" },
            "gender": { "type": "string", "enum": ["M", "F", "X"] },
            "nationality": { "type": "string", "default": "GHA" }
          }
        },
        "dg2FacePhotoBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Face photo extracted from Data Group 2 inside the chip."
        },
        "passiveAuthentication": {
          "type": "object",
          "required": ["isValid", "documentSignerCertBase64", "signatureAlgorithm"],
          "properties": {
            "isValid": { "type": "boolean" },
            "documentSignerCertBase64": { "type": "string" },
            "signatureAlgorithm": { "type": "string" }
          }
        },
        "activeAuthentication": {
          "type": "object",
          "required": ["isSupported", "isAuthentic"],
          "properties": {
            "isSupported": { "type": "boolean" },
            "isAuthentic": { "type": "boolean" }
          }
        }
      }
    },
    "biometrics": {
      "type": "object",
      "required": ["liveSelfieBase64", "livenessPassed", "faceMatchScore"],
      "properties": {
        "liveSelfieBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "livenessPassed": { "type": "boolean" },
        "faceMatchScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "verificationStatus": {
      "type": "object",
      "required": ["overallResult", "checks"],
      "properties": {
        "overallResult": {
          "type": "string",
          "enum": ["PASSED", "FLAGGED_FOR_REVIEW", "REJECTED"]
        },
        "checks": {
          "type": "object",
          "required": ["mrzMatch", "chipAuthentic", "faceMatch", "niaLookupMatch"],
          "properties": {
            "mrzMatch": { "type": "boolean" },
            "chipAuthentic": { "type": "boolean" },
            "faceMatch": { "type": "boolean" },
            "niaLookupMatch": { "type": "boolean" }
          }
        }
      }
    }
  }
}
