# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# capacitor / android
/android/.gradle/
/android/app/build/
/android/build/
/android/captures/
/android/local.properties
*.apk
*.aab
!releases/*.apk

# production
/build

# local media fallback when MinIO is unavailable
/storage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nested project copies (not part of the app)
/sheltergh-with-new-features/
/sheltergh-with-new-features-enhanced/
